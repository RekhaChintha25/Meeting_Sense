# Backend URL (Azure OpenAI). Copy to .env.local and set to your backend URL.
# Local: http://localhost:8000  |  Deploy: https://your-app.onrender.com
VITE_BACKEND_URL=http://localhost:8000

# Optional: shared password for login. If set, users must enter this to access the app.
# If not set, no login page is shown.
# VITE_LOGIN_PASSWORD=your-secret-password
